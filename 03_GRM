####extract items
get_aQ3 <- function(Q3) {
  
  idx <- which(lower.tri(Q3), arr.ind = TRUE)
  q3 <- Q3[idx]
  
  mean_q3 <- mean(q3, na.rm = TRUE)
  
  data.frame(
    item1 = rownames(Q3)[idx[, "row"]],
    item2 = colnames(Q3)[idx[, "col"]],
    Q3 = q3,
    aQ3 = q3 - mean_q3
  )
}


