##Now fit a simple 2 factor MIRT model
model_simple <- "
F1 = 1-7
F2 = 8-15
COV = F1*F2
"
###################################Fit the same model using different estimators##################################
###################################This tests if the same optimal solution is reached across methods###############
###################################The solution reached should be identical log-likelihoods, slopes, thresholds####3


#Use Expectation-Maximization algorithm
fit_simple_em <- mirt(
  data     = RS_items15,
  model    = model_simple,
  itemtype = "graded",
  method   = "EM",
  quadpts  = 31,
  SE       = TRUE,
  SE.type  = "Oakes",
  TOL      = 1e-4,
  technical = list(NCYCLES = 3000)
)

fit_simple_em
extract.mirt(fit_simple_em, "converged")

