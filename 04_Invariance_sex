####Convert the d's to b's
####Use mirt's native parameterization (d's instead of b's)
### b_k = -(d_k/a) for the specific factor
###Since we have a bifactor model, a2 would be the relevant one.



cf11_sex_native <- coef(
  mg_cross_metric_sex,
  IRTpars = FALSE,
  simplify = TRUE
)

groups <- c("Female", "Male")
items  <- c("rs5", "rs15")

get_b_F2 <- function(group, item) {
  
  pars <- cf11_sex_native[[group]]$items[item, ]
  
  a2 <- pars["a2"]
  d  <- pars[paste0("d", 1:4)]
  
  data.frame(
    group = group,
    item = item,
    threshold = paste0("b", 1:4),
    b_F2 = if (abs(a2) > 1e-10) -as.numeric(d) / as.numeric(a2) else NA
  )
}

b_F2_results <- do.call(
  rbind,
  lapply(groups, function(g) {
    lapply(items, function(i) get_b_F2(g, i))
  }) |> unlist(recursive = FALSE)
)

