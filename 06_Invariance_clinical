###Expected Score Difference
library(dplyr)
library(ggplot2)

# ------------------------------------------------------------
# 1. Generate expected F2 score curves separately for each group
# ------------------------------------------------------------
library(dplyr)
library(ggplot2)
library(mirt)


# Use the same theta grid used internally by expected_F2_score()
theta_grid <- seq(-3, 3, length.out = 501)

curve_nonclin <- data.frame(
  theta = theta_grid,
  expected_score = expected_F2_score(
    mg_cross_config_clin,
    "Nonclinical"
  )
)

curve_clin <- data.frame(
  theta = theta_grid,
  expected_score = expected_F2_score(
    mg_cross_config_clin,
    "Clinical"
  )
)

# Check that expected scores increase monotonically

plot(
  curve_nonclin$theta,
  curve_nonclin$expected_score,
  type = "l",
  lty = 1,
  lwd = 2,
  xlab = expression(paste("F2 ", theta)),
  ylab = "F2 Expected Score",
  ylim = range(
    curve_nonclin$expected_score,
    curve_clin$expected_score
  )
)

lines(
  curve_clin$theta,
  curve_clin$expected_score,
  lty = 2,
  lwd = 2
)

legend(
  "topleft",
  legend = c("Nonclinical", "Clinical"),
  lty = c(1, 2),
  lwd = 2,
  bty = "n"
)

# ------------------------------------------------------------
# 2. Find the group-specific theta corresponding to each
#    expected raw score
# ------------------------------------------------------------

score_marks <- 1:19

theta_nonclin <- approx(
  x = curve_nonclin$expected_score,
  y = curve_nonclin$theta,
  xout = score_marks
)$y

theta_clin <- approx(
  x = curve_clin$expected_score,
  y = curve_clin$theta,
  xout = score_marks
)$y

ruler_data <- bind_rows(
  data.frame(
    group = "Nonclinical",
    score = score_marks,
    theta = theta_nonclin
  ),
  data.frame(
    group = "Clinical",
    score = score_marks,
    theta = theta_clin
  )
)

ruler_data

ruler_data |>
  filter(score >= 10)

# ------------------------------------------------------------
# 3. Plot two separate latent-score rulers
# ------------------------------------------------------------
library(ggplot2)
library(dplyr)
library(patchwork)

# ------------------------------------------------------------
# Nonclinical ruler
# ------------------------------------------------------------

p_nonclin <- ruler_data |>
  filter(group == "Nonclinical") |>
  ggplot(aes(x = theta, y = 1)) +
  
  # Ruler line
  annotate(
    "segment",
    x = -3, xend = 3,
    y = 1, yend = 1,
    linewidth = 0.8
  ) +
  
  # Ordinary score notches
  geom_segment(
    data = \(x) filter(x, !highlight),
    aes(
      x = theta,
      xend = theta,
      y = 0.92,
      yend = 1.08
    ),
    linewidth = 0.5
  ) +
  
  # Score 15 notch
  geom_segment(
    data = \(x) filter(x, highlight),
    aes(
      x = theta,
      xend = theta,
      y = 0.87,
      yend = 1.13
    ),
    color = "red",
    linewidth = 1.2
  ) +
  
  # Ordinary score labels
  geom_text(
    data = \(x) filter(x, !highlight),
    aes(
      x = theta,
      y = 1.17,
      label = score
    ),
    size = 3
  ) +
  
  # Score 15 label
  geom_text(
    data = \(x) filter(x, highlight),
    aes(
      x = theta,
      y = 1.20,
      label = score
    ),
    color = "red",
    fontface = "bold",
    size = 4
  ) +
  
  scale_x_continuous(
    limits = c(-3, 3),
    breaks = -3:3
  ) +
  
  scale_y_continuous(
    limits = c(0.7, 1.4),
    breaks = NULL
  ) +
  
  labs(
    title = "Nonclinical",
    x = expression(paste("Nonclinical standardized ", theta[F2])),
    y = NULL
  ) +
  
  theme_classic() +
  theme(
    axis.line.y = element_blank(),
    axis.ticks.y = element_blank(),
    axis.text.y = element_blank()
  )


