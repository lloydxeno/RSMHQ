model <- '
F1 =~ rs1 + rs2 + rs3 + rs5 + rs6 + rs7 + rs14 + rs15
F2 =~ rs11 + rs12 + rs13 + rs14 + rs15
'

fit_cross_lavaan<- cfa(
  model,
  data = RS_items11[, 1:11],
  ordered = c("rs1","rs2","rs3","rs5","rs6","rs7",
              "rs11","rs12","rs13","rs14","rs15"),
  estimator = "WLSMV",
  std.lv = TRUE #Fix the latent variances to 1 instead of 
)

summary(
  fit_cross_lavaan,
  fit.measures = TRUE,
  standardized = TRUE
)
