##############Threshold

# Restrict to clinical participants with complete data
#Set the old values to NULL
dat_clin$F2_15plus <- NULL

dat_clin <- dat_score %>%
  filter(
    clinical == 1,
    !is.na(raw_F2),
    !is.na(theta_F2),
    !is.na(rsipas_total)
  ) %>%
  mutate(
    F2_15plus = factor(
      ifelse(raw_F2 >= 15, 1, 0),
      levels = c(0, 1),
      labels = c("F2 < 15", "F2 >= 15")
    )
  )

table(dat_clin$F2_15plus)

