stopifnot(nrow(dat_score) == nrow(RS_validation_minimal))

rsipas_items <- RS_validation_minimal[, paste0("rsipas", 1:10)]
dat_score <- cbind(dat_score, rsipas_items)

#Set raw_F1 and raw_F2 to NULL because
#these were based on the simple model
#Let RS14 and RS15 count towards both factors

dat_score$raw_F1 <- NULL
dat_score$raw_F2 <- NULL


#Recalculate using cross-loaded model
dat_score$raw_F1 <- rowSums(
  dat_score[, c(
    "rs1", "rs2", "rs3", "rs5", "rs6", "rs7",
    "rs14", "rs15"
  )],
  na.rm = FALSE
)

dat_score$raw_F2 <- rowSums(
  dat_score[, c(
    "rs11", "rs12", "rs13", "rs14", "rs15"
  )],
  na.rm = FALSE
)

table(dat_score$raw_F1)
table(dat_score$raw_F2)

###Omit item 6 see note in Oxhandler

rsipas_score_items <- paste0("rsipas", c(1:5, 7:10))

dat_score$rsipas_total <- rowSums(
  dat_score[, rsipas_score_items],
  na.rm = FALSE
)



