    y = 2, yend = 2,
    linewidth = 0.8
  ) +
  annotate(
    "segment",
    x = -2.5, xend = 2.5,
    y = 1, yend = 1,
    linewidth = 0.8
  ) +
  
  # Ordinary score notches
  geom_segment(
    data = subset(ruler_age, !highlight),
    aes(
      x = theta,
      xend = theta,
      y = y - 0.08,
      yend = y + 0.08
    ),
    linewidth = 0.5
  ) +
  
  # Highlight score 15
  geom_segment(
    data = subset(ruler_age, highlight),
    aes(
      x = theta,
      xend = theta,
      y = y - 0.13,
      yend = y + 0.13
    ),
    color = "red",
    linewidth = 1.2
  ) +
  
  # Ordinary score labels
  geom_text(
    data = subset(ruler_age, !highlight),
    aes(
      x = theta,
      y = y + 0.17,
      label = score
    ),
    size = 3
  ) +
  
  # Highlight score 15 label
  geom_text(
    data = subset(ruler_age, highlight),
    aes(
      x = theta,
      y = y + 0.20,
      label = score
    ),
    color = "red",
    fontface = "bold",
    size = 4
  ) +
  
  scale_y_continuous(
    breaks = c(1, 2, 3),
    labels = c("55+", "35–54", "18–34"),
    limits = c(0.6, 3.5)
  ) +
  
  scale_x_continuous(
    limits = c(-3, 3),
    breaks = -3:3
  ) +
  
  labs(
    title = "Factor 2 Score Rulers by Age",
    subtitle =
      "Raw-score locations derived from the partial scalar invariance model",
    x = expression(paste("F2 ", theta)),
    y = NULL
  ) +
  
  theme_classic() +
  
  theme(
    axis.line.y = element_blank(),
    axis.ticks.y = element_blank()
  )
