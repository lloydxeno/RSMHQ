# Function to obtain a cumulative ICC:
# d1 = P(X >= 1)
# d2 = P(X >= 2)
# d3 = P(X >= 3)
# d4 = P(X >= 4)
get_cum_icc <- function(model, item_name, threshold, groups, Theta) {
  
  item_no <- match(item_name, colnames(items11))
  
  out <- lapply(groups, function(g) {
    
    mod_g  <- extract.group(model, g)
    item_g <- extract.item(mod_g, item_no)
    
    pr <- probtrace(item_g, Theta)
    
    # Ensure rows correspond to theta values
    if (nrow(pr) != nrow(Theta) && ncol(pr) == nrow(Theta)) {
      pr <- t(pr)
    }
    
    # Cumulative probability P(X >= threshold)
    as.numeric(
      rowSums(
        pr[, (threshold + 1):ncol(pr), drop = FALSE]
      )
    )
  })
  
  out <- do.call(cbind, out)
  colnames(out) <- groups
  
  out
}

