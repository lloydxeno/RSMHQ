# Calculate the expected Factor 2 summed score for one group
expected_F2_score <- function(model, group_name) {
  
  group_model <- extract.group(model, group_name)
  
  item_scores <- sapply(F2_items, function(item_number) {
    
    item_object <- extract.item(
      group_model,
      item_number
    )
    
    category_probabilities <- probtrace(
      item_object,
      Theta
    )
    
    category_scores <- 0:(ncol(category_probabilities) - 1)
    
    as.numeric(
      category_probabilities %*% category_scores
    )
  })
  
  rowSums(item_scores)
}

